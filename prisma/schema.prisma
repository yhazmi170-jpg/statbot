generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id               String             @id
  name             String
  iconUrl          String?
  prefix           String             @default("m?")
  timezone         String             @default("UTC")
  ownerId          String?
  memberCount      Int                @default(0)
  channelCount     Int                @default(0)
  roleCount        Int                @default(0)
  emojiCount       Int                @default(0)
  boostLevel       Int                @default(0)
  boostCount       Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  channelStats     ChannelStats[]
  excludedChannels ExcludedChannel[]
  excludedRoles    ExcludedRole[]
  dailyStats       GuildDailyStats[]
  hourlyStats      GuildHourlyStats[]
  reportConfigs    ReportConfig[]
  userDailyStats   UserDailyStats[]
  userChannelStats UserChannelStats[]
  userHourlyStats  UserHourlyStats[]
  voiceSessions    VoiceSession[]

  @@index([ownerId])
}

model User {
  id            String           @id
  username      String
  avatarUrl     String?
  createdAt     DateTime         @default(now())
  dailyStats    UserDailyStats[]
  channelStats  UserChannelStats[]
  hourlyStats   UserHourlyStats[]
  voiceSessions VoiceSession[]

  @@index([username])
}

model Channel {
  id        String   @id
  name      String
  type      String   @default("text")
  guildId   String
  createdAt DateTime @default(now())
  userStats UserChannelStats[]

  @@index([guildId])
  @@index([name])
}

model GuildDailyStats {
  id            String   @id @default(cuid())
  guildId       String
  date          DateTime
  totalMessages Int      @default(0)
  uniqueUsers   Int      @default(0)
  totalVoiceMs  BigInt   @default(0)
  joins         Int      @default(0)
  leaves        Int      @default(0)
  createdAt     DateTime @default(now())
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, date])
  @@index([guildId, date])
  @@index([date])
}

model GuildHourlyStats {
  id       String   @id @default(cuid())
  guildId  String
  date     DateTime
  hour     Int
  messages Int      @default(0)
  voiceMs  BigInt   @default(0)
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, date, hour])
  @@index([guildId, date])
  @@index([date])
}

model UserDailyStats {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  date         DateTime
  messages     Int      @default(0)
  voiceMs      BigInt   @default(0)
  topChannelId String?
  topHour      Int?
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, date])
  @@index([guildId, userId, date])
  @@index([guildId, date])
  @@index([userId, date])
}

model ChannelStats {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  date        DateTime
  messages    Int      @default(0)
  uniqueUsers Int      @default(0)
  voiceMs     BigInt   @default(0)
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId, date])
  @@index([guildId, channelId, date])
  @@index([guildId, date])
  @@index([channelId, date])
}

model UserChannelStats {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  channelId String
  date      DateTime
  messages  Int      @default(0)
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, channelId, date])
  @@index([guildId, userId, date])
  @@index([guildId, channelId, date])
  @@index([guildId, date])
  @@index([userId, date])
}

model UserHourlyStats {
  id       String   @id @default(cuid())
  guildId  String
  userId   String
  date     DateTime
  hour     Int
  messages Int      @default(0)
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, date, hour])
  @@index([guildId, userId, date])
  @@index([guildId, date])
  @@index([userId, date])
}

model VoiceSession {
  id         String    @id @default(cuid())
  guildId    String
  userId     String
  channelId  String
  channelName String?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  durationMs BigInt    @default(0)
  guild      Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, startedAt])
  @@index([guildId, channelId, startedAt])
  @@index([startedAt])
  @@index([guildId, startedAt])
}

model ReportConfig {
  id        String    @id @default(cuid())
  guildId   String
  channelId String
  interval  String    @default("weekly")
  enabled   Boolean   @default(true)
  lastRun   DateTime?
  createdAt DateTime  @default(now())
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId])
}

model ExcludedChannel {
  id        String @id @default(cuid())
  guildId   String
  channelId String
  guild     Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId])
}

model ExcludedRole {
  id      String @id @default(cuid())
  guildId String
  roleId  String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, roleId])
}

model LegacyUserStats {
  id                String   @id @default(cuid())
  guildId           String
  discordUserId     String?
  importedUsername   String
  messageCount14d   Int      @default(0)
  voiceSeconds14d   Int      @default(0)
  messageRank       Int?
  voiceRank         Int?
  linked            Boolean  @default(false)
  importKey         String
  source            String   @default("legacy-statbot")
  importedAt        DateTime @default(now())

  @@unique([guildId, importedUsername, importKey])
  @@index([guildId, discordUserId])
  @@index([guildId, linked])
  @@index([importKey])
}

model LegacyChannelStats {
  id              String   @id @default(cuid())
  guildId         String
  channelId       String?
  channelName     String
  channelType     String   @default("text")
  messageCount14d Int      @default(0)
  voiceSeconds14d Int      @default(0)
  channelRank     Int?
  voiceChannelRank Int?
  linked          Boolean  @default(false)
  importKey       String
  source          String   @default("legacy-statbot")
  importedAt      DateTime @default(now())

  @@unique([guildId, channelName, importKey])
  @@index([guildId, linked])
  @@index([importKey])
}

model ImportLog {
  id        String   @id @default(cuid())
  importKey String
  guildId   String
  status    String
  message   String?
  timestamp DateTime @default(now())

  @@unique([importKey, guildId])
}
